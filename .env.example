# ============================================================
# 复制本文件为 .env 后填写真实值；.env 已在 .gitignore 中，不会被提交。
# ============================================================

# ---------- 大模型（OpenAI 兼容协议）----------
# 任选其一：DeepSeek / 阿里云 DashScope 兼容模式 / OpenAI 官方
LLM_BASE_URL=https://api.deepseek.com
# 阿里云 DashScope（兼容模式）注意：Spring AI 会自动拼接 /v1/chat/completions，
# 所以这里只写到 /compatible-mode，多写 /v1 会得到 404：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat

# ---------- 向量化方式 ----------
# openai       = 走上面 base-url + api-key 的云端 Embedding（推荐用于中文库：
#                DashScope text-embedding-v3 为 1024 维，中文区分度好）
# transformers = 本地 ONNX all-MiniLM-L6-v2，384 维，完全离线零依赖；
#                但它是英文语料训练的小模型，中文长句余弦相似度高度接近，
#                只适合跑通链路，不适合做中文质量判断
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v3
# 使用 transformers 时改回：
# EMBEDDING_PROVIDER=transformers
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------- PGvector（pgvector profile 才用）----------
# dimensions 必须与所选 Embedding 模型的输出维度一致，否则建表/写入会失败
PG_URL=jdbc:postgresql://localhost:5432/kb
PG_USERNAME=kb
PG_PASSWORD=kb
PGVECTOR_DIMENSIONS=1024

# ---------- 运行模式 ----------
# local   = 内存向量库，零基础设施（默认）
# pgvector= 真实 PGvector 持久化
SPRING_PROFILES_ACTIVE=local
